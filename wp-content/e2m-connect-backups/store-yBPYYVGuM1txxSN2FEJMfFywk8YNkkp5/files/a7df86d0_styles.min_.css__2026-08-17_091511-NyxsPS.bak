:root{--bg:#0A0618;--bg-2:#110A26;--panel:#140C2E;--panel-2:#1A1038;--violet:#7C3AED;--nebula:#6D2FD1;--magenta:#D946A8;--coral:#F0793E;--coral-2:#F79A5C;--peach:#FBBE8C;--spark-p:#8B5CF6;--spark-t:#38C9D8;--cream:#FBF0EA;--ink:#241638;--tx:#EDE8FF;--tx-dim:#A79BD0;--tx-faint:#6F639B;--line:rgba(237,232,255,.1);--line-2:rgba(237,232,255,.18);--grad-cta:linear-gradient(92deg,#F0793E,#F79A5C 55%,#FBBE8C);--grad-word:linear-gradient(100deg,#F79A5C,#F0793E 35%,#E45FA3 70%,#8B5CF6 105%);--grad-spark:linear-gradient(135deg,#8B5CF6,#38C9D8);--r-xl:24px;--r-lg:18px;--r-md:12px;--wrap:1160px;--nav-h:74px;--ease:cubic-bezier(.22,.75,.25,1);--glow-cta:0 10px 40px -10px rgba(240,121,62,.6)}*{margin:0;padding:0;box-sizing:border-box}html{scroll-behavior:smooth}body{font-family:"Poppins",sans-serif;background:var(--bg);color:var(--tx);line-height:1.7;overflow-x:hidden;-webkit-font-smoothing:antialiased}img{display:block;max-width:100%}a{color:inherit;text-decoration:none}:focus-visible{outline:2px solid var(--coral);outline-offset:3px;border-radius:4px}::selection{background:rgba(240,121,62,.35);color:#fff}.field{position:fixed;inset:0;pointer-events:none;z-index:0}.field::before{content:"";position:absolute;inset:0;background-image:radial-gradient(rgba(237, 232, 255, 0.055) 1px, transparent 1px);background-size:34px 34px;mask-image:radial-gradient(80% 70% at 50% 30%, #000 30%, transparent 100%)}.field::after{content:"";position:absolute;inset:0;background:radial-gradient(52% 44% at 18% 0%, rgba(109, 47, 209, 0.28), transparent 70%),radial-gradient(46% 40% at 86% 12%, rgba(217, 70, 168, 0.16), transparent 70%),radial-gradient(60% 50% at 50% 108%, rgba(109, 47, 209, 0.2), transparent 72%)}.rails{position:fixed;inset:0;pointer-events:none;z-index:1}.rails::before,.rails::after{content:"";position:absolute;top:0;bottom:0;width:1px;background:linear-gradient(180deg, transparent, var(--line) 12%, var(--line) 88%, transparent)}.rails::before{left:max(20px,50% - var(--wrap)/2 - 34px)}.r