teY(0.16em)}.foot .logo-img{height:48px}.logo-tag{font-family:"JetBrains Mono",monospace;font-size:.56rem;letter-spacing:.14em;text-transform:uppercase;color:var(--tx-faint);padding-left:2px}.hero{position:relative;min-height:100vh;min-height:100svh;display:flex;flex-direction:column;justify-content:center;padding:calc(var(--nav-h) + 60px) 0 40px;z-index:3}#net{position:absolute;inset:0;z-index:-1;opacity:.85}.hero-core{display:grid;grid-template-columns:.94fr 1.06fr;gap:44px;align-items:center;text-align:left}.hero-copy{display:flex;flex-direction:column;align-items:flex-start;gap:1.5rem}.hero-media{position:relative;margin-right:-30px}.hud-chip{display:inline-flex;align-items:center;gap:.7rem;font-family:"JetBrains Mono",monospace;font-size:.72rem;letter-spacing:.26em;text-transform:uppercase;color:var(--tx-dim);border:1px solid var(--line-2);border-radius:999px;padding:.62rem 1.15rem;background:rgba(20,12,46,.5);backdrop-filter:blur(8px)}.dot{width:7px;height:7px;border-radius:50%;background:var(--coral);box-shadow:0 0 10px var(--coral);animation:blip 2.2s ease-in-out infinite}@keyframes blip{50%{opacity:.35}}.hero-sub{font-family:"JetBrains Mono",monospace;font-size:clamp(1rem,2vw,1.35rem);color:var(--tx)}.hero-sub .pr{color:var(--coral)}.caret{display:inline-block;width:.6em;height:1.15em;background:var(--coral);margin-left:.3rem;vertical-align:-0.2em;animation:blink 1s steps(1) infinite}@keyframes blink{50%{opacity:0}}.hero-meta{display:flex;flex-wrap:wrap;justify-content:flex-start;gap:.7rem}.meta-pill{display:inline-flex;align-items:center;gap:.55rem;font-family:"JetBrains Mono",monospace;font-size:.78rem;letter-spacing:.12em;text-transform:uppercase;color:var(--tx);border:1px solid var(--line-2);border-radius:8px;padding:.6rem 1rem;background:rgba(20,12,46,.55)}.meta-pill svg{width:15px;height:15px;stroke:var(--coral)}.hero-cta{margin-top:.6rem}.hero-frame{position:absolute;inset:calc(var(--nav-h) + 26px) 26px 26px;pointer-events:none;z-index:-1}.hero-frame i{position:absolute;width:22px;height:22px;border:1px solid var(--line-2)}.hero-frame i:nth-child(1){top:0;left:0;border-width:1px 0 0 1px}.hero-frame i:nth-child(2){top:0;right:0;border-width:1px 1px 0 0}.hero-frame i:nth-child(3){bottom:0;left:0;border-width:0 0 1px 1px}.hero-frame i:nth-child(4){bottom:0;right:0;border-width:0 1px 1px 0}.scroll-cue{position:absolute;bottom:26px;left:50%;transform:translateX(-50%);width:1px;height:52px;overflow:hidden}.scroll-cue::before{content:"";position:absolute;inset:0;background:linear-gradient(180deg, transparent, var(--coral));animation:fall 1.8s ease-in-out infinite}@keyframes fall{0%{transform:translateY(-100%)}70%,100%{transform:translateY(100%)}}.portal{position:relative;border-radius:var(--r-xl);cursor:pointer;isolation:isolate}.portal::before{content:"";position:absolute;inset:-1px;border-radius:calc(var(--r-xl) + 1px);z-index:-1;background:conic-gradient(from var(--sp, 0deg), var(--spark-p), var(--spark-t) 25%, var(--coral) 55%, var(--magenta) 80%, var(--spark-p));animation:rot 10s linear infinite}@property --sp{syntax:"<angle>";initial-value:0deg;inherits:false}@keyframes rot{to{--sp:360deg}}.portal::after{content:"";position:absolute;inset:-40px;z-index:-2;border-radius:48px;background:radial-gradient(55% 60% at 50% 50%, rgba(139, 92, 246, 0.35), transparent 70%);filter:blur(22px)}.portal img{width:100%;border-radius:var(--r-xl);aspect-ratio:16/10.4;object-fit:cover}.portal .scan{position:absolute;inset:0;border-radius:var(--r-xl);pointer-events:none;background:repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.05) 0 1px, transparent 1px 4px);mix-blend-mode:overlay;opacity:.5}.portal .veil{position:absolute;inset:0;border-radius:var(--r-xl);background:linear-gradient(180deg, rgba(10, 6, 24, 0.05), rgba(10, 6, 24, 0.4));transition:.4s}.portal:hover .veil{background:linear-gradient(180deg, transparent, rgba(10, 6, 24, 0.22))}.play{position:absolute;top:50%;left:50%;transform:translate(-50%, -50%);width:82px;heig