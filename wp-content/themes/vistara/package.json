{
  "name": "vistara-theme",
  "version": "1.0.0",
  "private": true,
  "description": "Build scripts for the Vistara WordPress theme (SCSS -> assets/css via Dart Sass).",
  "scripts": {
    "build:css": "sass assets/scss/main.scss assets/css/styles.css --no-source-map --style=expanded",
    "build:css:min": "sass assets/scss/main.scss assets/css/styles.min.css --no-source-map --style=compressed",
    "build": "npm run build:css && npm run build:css:min",
    "watch:css": "sass --watch assets/scss/main.scss:assets/css/styles.css --no-source-map --style=expanded"
  },
  "devDependencies": {
    "sass": "^1.77.0"
  }
}
